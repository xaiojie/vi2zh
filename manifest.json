{
  "manifest_version": 3,
  "name": "越译中 · 网页翻译（DeepSeek）",
  "version": "1.3.1",
  "description": "用 DeepSeek 把越南语网页整页翻译成简体中文：覆盖动态渲染、iframe、Shadow DOM、占位符与提示文本。",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "越译中 · 翻译当前页面（Alt+T）",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "contextMenus",
    "activeTab",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://api.deepseek.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://api.github.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "src/shared/platform.js",
        "src/shared/defaults.js",
        "src/shared/lang.js",
        "src/shared/sites.js",
        "src/content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "match_origin_as_fallback": true
    }
  ],
  "commands": {
    "toggle-translate": {
      "suggested_key": {
        "default": "Alt+T"
      },
      "description": "翻译 / 还原当前页面"
    }
  },
  "options_ui": {
    "page": "src/options.html",
    "open_in_tab": true
  }
}
